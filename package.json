{
  "name": "zipbot",
  "type": "module",
  "private": true,
  "version": "2026.7",
  "description": "",
  "scripts": {
    "build": "tsc",
    "start": "bun ./src/index.ts",
    "start:prod": "bun run prisma:generate && bun run prisma:migrate && bun start",
    "start:dev": "bun --watch --trace-warnings ./src/index.ts",
    "prisma:generate": "prisma generate --sql",
    "prisma:migrate": "prisma migrate deploy",
    "task:fetcher": "bun ./src/tasks/fetcher.ts"
  },
  "author": "grenuttag <me@grenuttag.com>",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "discord.js": "^14.27.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
